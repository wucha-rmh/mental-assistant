# =============================================================================
# 心理健康AI助手 —— Nginx 站点示例
# =============================================================================
# 用法：复制到 /etc/nginx/conf.d/mental-health.conf，把 server_name 换成你的域名，
#       nginx -t && systemctl reload nginx。HTTPS 交给 certbot（见 docs/deploy.md）。
# 说明：这个文件里的三处加固，正是「登录限流 / 上传白名单 / 密钥轮换」三项修复
#       在网关层的部分——应用层已经改好，这里是纵深防御。
# =============================================================================

# ── 登录接口限流 ─────────────────────────────────────────────────────────────
# 10m 内存约可存 16 万个 IP。同一 IP 每分钟 5 次登录，突发再多给 5 次。
# 应用层还有一套「同一账号连错 5 次锁 15 分钟」（LoginAttemptLimiter），两层互补：
# 应用层按账号防定向爆破，Nginx 按 IP 防撞库扫号。
limit_req_zone $binary_remote_addr zone=mha_login:10m rate=5r/m;

server {
    listen 80;
    server_name your-domain.com;              # ← 改成你的域名

    # 上传接口最大 10MB，需与后端 spring.servlet.multipart.max-request-size 一致
    client_max_body_size 10m;

    # ── 前端静态文件 ─────────────────────────────────────────────────────────
    root /var/www/mental-health/dist;         # ← npm run build 的产物目录
    index index.html;

    # 前端路由是 createWebHistory（没有 # 号），刷新 /back/users 这类子路径要回落到 index.html
    location / {
        try_files $uri $uri/ /index.html;
    }

    # ── 后端接口 ─────────────────────────────────────────────────────────────
    location /api/ {
        proxy_pass http://127.0.0.1:1236;
        proxy_http_version 1.1;
        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        # ⚠️ SSE 必须关掉缓冲：否则 AI 回复不会逐字出现，而是等全文生成完一次性吐出
        proxy_buffering off;
        proxy_cache off;
        proxy_read_timeout 300s;              # AI 生成慢，默认 60s 会中途断流
        proxy_send_timeout 300s;
        chunked_transfer_encoding on;
    }

    # 登录接口：精确匹配优先级最高，单独套限流
    location = /api/user/login {
        limit_req zone=mha_login burst=5 nodelay;
        limit_req_status 429;
        proxy_pass http://127.0.0.1:1236;
        proxy_http_version 1.1;
        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # ── 上传文件（用户上传的内容）────────────────────────────────────────────
    # 后端已按扩展名白名单收口（只收图片 jpg/jpeg/png/gif/bmp/webp 与视频 mp4/webm），
    # 这里再兜一层：① 明确拒绝脚本/页面类后缀 ② nosniff ③ CSP sandbox（万一被当页面打开，
    # 也拿不到同源的 localStorage，里面存着 JWT）。
    location /files/ {
        proxy_pass http://127.0.0.1:1236;
        proxy_set_header Host $host;

        add_header X-Content-Type-Options nosniff always;
        add_header Content-Security-Policy "default-src 'none'; img-src 'self'; media-src 'self'; sandbox" always;

        location ~* \.(php|jsp|asp|aspx|sh|py|rb|pl|cgi|htm|html|svg|xml|js|mjs)$ {
            deny all;
        }
    }
}

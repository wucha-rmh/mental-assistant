# /etc/mha/mha.env —— 后端环境变量（chmod 600 /etc/mha/mha.env，属主 mha）
# 这些值的优先级高于 application.yaml 与 application-local.yaml，生产环境只用这里。
#
# ⚠️ JWT_SECRET 必须 ≥ 32 位（后端启动时会强制校验，不合格直接拒绝启动）。
#    生成：openssl rand -base64 48
JWT_SECRET=请替换为openssl生成的新随机串至少32位
# 数据库
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USERNAME=mha
DB_PASSWORD=请替换为数据库专用账号的口令
# AI（DeepSeek）—— 若不用 application-local.yaml，就在这里配上
# SPRING_AI_OPENAI_API_KEY=sk-xxx

# /etc/systemd/system/mha.service —— 心理健康AI助手 后端托管
# 安装：
#   sudo cp deploy/mha.service /etc/systemd/system/mha.service
#   sudo systemctl daemon-reload && sudo systemctl enable --now mha
#   journalctl -u mha -f          # 看日志
[Unit]
Description=Mental Health Assistant Backend (Spring Boot)
After=network.target mysql.service

[Service]
Type=simple
User=mha
WorkingDirectory=/opt/mha/backend
# ⚠️ 时区必须显式设置：看板的「今天/趋势」、日记日期、每天 03:30 的临时文件清理 cron
#    都按系统时区算，不设会整体偏 8 小时。
Environment="TZ=Asia/Shanghai"
# 密钥与数据库口令走环境变量（优先级高于打成 jar 的 application.yaml，也高于 application-local.yaml）
EnvironmentFile=/etc/mha/mha.env
ExecStart=/usr/bin/java -Xms256m -Xmx512m -jar app.jar
# 应用自 2C4G 起步够用；AI 调用发往 api.deepseek.com，服务器不需要 GPU
SuccessExitStatus=143
Restart=on-failure
RestartSec=10

[Install]
WantedBy=multi-user.target
